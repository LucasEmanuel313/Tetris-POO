{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: Build Debug (console)",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-IC:\\SFML-3.0.2\\include",
                "-Iinclude",
                "-mconsole",
                "src/main.cpp",
                "src/net_client.cpp",
                "src/server.cpp",
                "src/table.cpp",
                "src/Game.cpp",
                "src/Multiplayer.cpp",
                "src/WindowManager.cpp",
                "src/SinglePlayerState.cpp",
                "-LC:\\SFML-3.0.2\\lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-lsfml-audio",
                "-lws2_32",
                "-lstdc++",
                "-o",
                "bin\\debug.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: Build Game (no console)",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-IC:\\SFML-3.0.2\\include",
                "-Iinclude",
                "-mwindows",
                "src/main.cpp",
                "src/net_client.cpp",
                "src/server.cpp",
                "src/table.cpp",
                "src/Game.cpp",
                "src/Multiplayer.cpp",
                "src/WindowManager.cpp",
                "src/SinglePlayerState.cpp",
                "-LC:\\SFML-3.0.2\\lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-lsfml-audio",
                "-lws2_32",
                "-lstdc++",
                "-o",
                "bin\\game.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ],
    "version": "2.0.0"
}