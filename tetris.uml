@startuml
title Tetris multijoueur - Diagramme de cas d'utilisation
top to bottom direction

actor Joueur
actor "Serveur de parties" as Serveur

rectangle "Système : Tetris multijoueur" {

  rectangle "Mode solo" as Solo {
    usecase "Démarrer une\npartie solo" as UC_StartSolo
    usecase "Jouer en solo" as UC_PlaySolo
  }

  rectangle "Mode multijoueur" as Multi {
    usecase "Créer une salle\nmultijoueur" as UC_CreateRoom
    usecase "Rejoindre une salle" as UC_JoinRoom
    usecase "Lancer la partie\nmultijoueur" as UC_StartMP
    usecase "Jouer une partie\nmultijoueur" as UC_PlayMP
    usecase "Voir les résultats\nde la partie" as UC_Results
  }
}

' Ligações do Joueur (mais “limpas”)
Joueur -down-> UC_StartSolo
Joueur -down-> UC_PlaySolo

Joueur -down-> UC_CreateRoom
Joueur -down-> UC_JoinRoom
Joueur -down-> UC_PlayMP
Joueur -down-> UC_Results

' Ligações do Serveur (focado em rede)
Serveur -down-> UC_CreateRoom
Serveur -down-> UC_JoinRoom
Serveur -down-> UC_StartMP
Serveur -down-> UC_PlayMP

' Relações de include
UC_StartSolo .> UC_PlaySolo : <<include>>
UC_StartMP   .> UC_PlayMP   : <<include>>
UC_PlayMP    .> UC_Results  : <<include>>

@enduml
